# Minimal required configuration.
# Copy to .env and fill in your values.
#
# All other settings (scrape interval, alert thresholds, proxy, etc.)
# are configured in the WebUI under Advanced settings.

DOCKER=/path/to/docker/data   # where volumes are stored
DOMAIN=example.com             # used for reverse proxy labels
TZ=Europe/Stockholm            # timezone (IANA format)

# Optional. Fine-grained GitHub PAT scoped to this repo with "Issues: Write"
# only. If set, an unhandled error in api/webui/scraper/alerts automatically
# opens a GitHub issue tagged @claude (so the repo's existing Claude Code
# Action picks it up) instead of just failing silently. Sensitive data
# (API keys/tokens, emails, file content, paths with usernames) is redacted
# before anything is sent.
GITHUB_ERROR_REPORT_TOKEN=
