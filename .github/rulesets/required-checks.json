{
  "name": "required-checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Dependency review"
          },
          {
            "context": "Node and Cloudflare"
          },
          {
            "context": "Python"
          },
          {
            "context": "Container security / app"
          },
          {
            "context": "Container security / scraper"
          },
          {
            "context": "Container security / fetcher"
          },
          {
            "context": "Conventional PR title"
          }
        ],
        "strict_required_status_checks_policy": false
      }
    }
  ],
  "bypass_actors": []
}
