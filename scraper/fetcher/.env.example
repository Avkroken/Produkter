# Copy to .env on the render host and fill only the secret value locally.
# Never commit .env.
ENGINE_URL=https://motor.denied.se
INGEST_API_KEY=

# Conservative defaults. Raise only after observing queue/runtime behavior.
FETCHER_CONCURRENCY=3
LEASE_BATCH=10
POLL_IDLE_SEC=15
RENDER_WAIT_MS=12000
MAX_LIST_PAGES=60
