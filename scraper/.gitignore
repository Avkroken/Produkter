# Scraper-specific ignores. Everything generic (Python, Node, secrets, logs,
# editors, Docker) lives in the repo root .gitignore.

# Scraped data and local databases
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Scraper output — .txt is an output format here, so it is ignored wholesale
products.txt
*.txt
!requirements.txt

# Backups and scratch
backups/
*.backup
tmp/
temp/
*.tmp
*.orig
