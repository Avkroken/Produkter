{
  "name": "produkter-motor",
  "private": true,
  "type": "module",
  "scripts": {
    "config:generate": "node ../scripts/configure.mjs",
    "dev": "npm run config:generate && wrangler dev --remote",
    "preview": "npm run config:generate && wrangler preview",
    "deploy": "npm run config:generate && wrangler deploy --strict",
    "verify:production": "node ../scripts/verify-production.mjs engine",
    "typecheck": "tsc --noEmit",
    "secret:set-ingest-key": "npm run config:generate && wrangler secret put INGEST_API_KEY"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
