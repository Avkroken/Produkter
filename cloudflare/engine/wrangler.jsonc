{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter-motor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  // @cloudflare/playwright requires nodejs_compat and a compatibility date >= 2025-09-15.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // EN cron (*/5). Core-handlern skapar/underhåller render_jobs och den yttre
  // Worker-entrypointen konsumerar därefter ett litet antal via Browser Run.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "SCHEDULE_LIMIT": "200",
    "DESCRIBE_LIMIT": "10",
    "DESCRIBE_WORKERS": "2",
    "BROWSER_RENDER_LIMIT": "3",
    "BROWSER_MAX_LIST_PAGES": "20"
  },
  // Custom domain — kontots workers.dev blockeras (403/1050); övriga Workers
  // använder också custom domains. HTTP-endpoints skyddas av X-API-Key.
  "routes": [
    { "pattern": "motor.denied.se", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "produkter",
      "database_id": "f1301925-95c3-47c7-b513-a25d4cfaf881"
    }
  ]
  // Secrets (wrangler secret put):
  //   INGEST_API_KEY
  //   GEMINI_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY / AZURE_*
}
