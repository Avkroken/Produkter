{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter-motor",
  "ai": {
    "binding": "AI"
  },
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "SCHEDULE_LIMIT": "200",
    "DESCRIBE_LIMIT": "10",
    "DESCRIBE_WORKERS": "2",
    "CRAWL_SITE_LIMIT": "2",
    "CRAWL_PAGE_LIMIT": "100",
    "BROWSER_RENDER_LIMIT": "3",
    "BROWSER_MAX_LIST_PAGES": "20"
  },
  "routes": [
    {
      "pattern": "motor.denied.se",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "produkter",
      "database_id": "f1301925-95c3-47c7-b513-a25d4cfaf881"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CLOUDFLARE_API_TOKEN_W1",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "CLOUDFLARE_API_TOKEN_W1"
    }
  ]
}
