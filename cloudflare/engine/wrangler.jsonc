{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter-motor",
  "ai": { "binding": "AI" },
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  // @cloudflare/playwright requires nodejs_compat and a compatibility date >= 2025-09-15.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // EN cron (*/5). Core-handlern schemalägger arbetet. Den yttre Workern
  // delegerar list-jobb till Cloudflare /crawl och använder Playwright endast
  // som fallback för jobb som crawl inte kan hantera.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "SCHEDULE_LIMIT": "200",
    "DESCRIBE_LIMIT": "10",
    "DESCRIBE_WORKERS": "2",
    "CRAWL_SITE_LIMIT": "2",
    "CRAWL_PAGE_LIMIT": "100",
    "BROWSER_RENDER_LIMIT": "3",
    "BROWSER_MAX_LIST_PAGES": "20"
  },
  // Custom domain — kontots workers.dev blockeras (403/1050); övriga Workers
  // använder också custom domains. HTTP-endpoints skyddas av X-API-Key.
  "routes": [
    { "pattern": "motor.denied.se", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "produkter",
      "database_id": "f1301925-95c3-47c7-b513-a25d4cfaf881"
    }
  ]
  // Secrets (wrangler secret put):
  //   INGEST_API_KEY
  //   CLOUDFLARE_ACCOUNT_ID
  //   CLOUDFLARE_BROWSER_TOKEN  (API-token med Browser Rendering - Edit)
  //   GEMINI_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY / AZURE_*
}
