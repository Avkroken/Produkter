{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "containers": [
    {
      "class_name": "ScraperContainer",
      "image": "../../scraper/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCRAPER_CONTAINER",
        "class_name": "ScraperContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScraperContainer"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "DB_NAME": "scraper",
    "DB_USER": "scraper",
    "TZ": "Europe/Stockholm"
  }
}
