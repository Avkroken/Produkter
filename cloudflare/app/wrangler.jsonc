{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter",
  "main": "src/access-worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Huvuddomänen för tjänsten.
  "routes": [{ "pattern": "produkter.denied.se", "custom_domain": true, "enabled": true, "previews_enabled": false }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/signup", "/login", "/logout", "/underlag", "/admin", "/admin/*"]
  },
  "services": [
    {
      "binding": "ENGINE",
      "service": "produkter-motor"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "produkter-eu-v2",
      "database_id": "33bd7f7b-a3f2-483b-968b-ddd99f3ad356"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "produkter-uppladdningar"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "adafd9ea9ec24bc8ab8da87ff80467cc"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "produkter-jobb",
        "binding": "JOB_QUEUE"
      }
    ]
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "produkter.denied.se",
    // INGEST_API_KEY sätts som secret och används även på interna engine-anrop.
    // OAuth-inloggning — egna appar för produkter. Microsoft client_id
    // och båda client_secret sätts som wrangler secrets. Callback-URL:er registrerade i
    // respektive OAuth-app: produkter.denied.se/api/oauth/<provider>/callback.
    "OAUTH_GOOGLE_CLIENT_ID": "551393755081-gtbd45b203icbbp0cu0q0p4meppli2fu.apps.googleusercontent.com",
    "MAIL_FROM": "noreply@denied.se",
    "ADMIN_EMAIL": "anders.eriksson@denied.se"
  }
}
