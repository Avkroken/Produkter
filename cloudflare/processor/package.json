{
  "name": "produkter-bearbetare",
  "private": true,
  "type": "module",
  "scripts": {
    "config:generate": "node ../scripts/configure.mjs",
    "dev": "npm run config:generate && wrangler dev --remote",
    "preview": "npm run config:generate && wrangler preview",
    "deploy": "npm run config:generate && wrangler deploy --strict",
    "secret:set-provider-key": "npm run config:generate && wrangler secret put PROVIDER_CONFIG_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "mammoth": "^1.12.3",
    "read-excel-file": "^9.3.10",
    "unpdf": "^1.8.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "sharp": "^0.35.4"
  }
}
