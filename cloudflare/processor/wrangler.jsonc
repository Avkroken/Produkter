{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter-bearbetare",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // nodejs_compat: behövs av beroenden som använder node:-API:er.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "produkter",
      "database_id": "f1301925-95c3-47c7-b513-a25d4cfaf881"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "produkter-uppladdningar"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "produkter-jobb",
        "max_batch_size": 10,
        "max_retries": 10,
        "max_concurrency": 4
      }
    ],
    "producers": [
      {
        "queue": "produkter-jobb",
        "binding": "JOB_QUEUE"
      }
    ]
  }
}
