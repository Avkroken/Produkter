{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "produkter-bearbetare",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "previews": {},
  "build": {
    "command": "node ../scripts/guard-portable-deploy.mjs"
  },
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "DB",
        "type": "inherit",
        "version_id": "latest"
      },
      {
        "name": "JOB_QUEUE",
        "type": "inherit",
        "version_id": "latest"
      },
      {
        "name": "UPLOADS",
        "type": "inherit",
        "version_id": "latest"
      },
      {
        "name": "PROVIDER_CONFIG_KEY",
        "type": "inherit",
        "version_id": "latest"
      }
    ]
  }
}
